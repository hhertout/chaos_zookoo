CHAOS_CONFIG_DIR="./local"
# Prometheus /metrics HTTP endpoint. Default: :9090
METRICS_ADDR=9090

K8S_HOST=
K8S_CLUSTER_CERT=
K8S_TOKEN=

# Grafana backend used by the testing kit. Required if any module declares a
# `testing:` block. GRAFANA_TOKEN is sent as a bearer credential.
GRAFANA_URL=
GRAFANA_TOKEN=
